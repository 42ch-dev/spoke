<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>spoke-connect-csharp-smoke</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Prefer the packable library (RID natives when assembled; local cargo
         cdylib fallback via 42ch.Spoke.Connect.csproj CopyLocal target). -->
    <ProjectReference Include="..\42ch.Spoke.Connect.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Golden hello vector fixture (registered byte-identical copy of the
         crate SSOT — see tooling/connect/golden-vector-sync.mjs). -->
    <None Include="fixtures\golden-hello.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Native must sit beside the referenced DLL in *this* output dir. -->
  <Target Name="CopySpokeConnectNativeFromLibrary" AfterTargets="Build">
    <PropertyGroup>
      <_LibOut>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\bin\$(Configuration)\$(TargetFramework)\'))</_LibOut>
      <_NativeName Condition="$([MSBuild]::IsOSPlatform('OSX'))">libspoke_connect.dylib</_NativeName>
      <_NativeName Condition="$([MSBuild]::IsOSPlatform('Linux'))">libspoke_connect.so</_NativeName>
      <_NativeName Condition="$([MSBuild]::IsOSPlatform('Windows'))">spoke_connect.dll</_NativeName>
    </PropertyGroup>
    <Copy SourceFiles="$(_LibOut)$(_NativeName)"
          DestinationFolder="$(OutputPath)"
          SkipUnchangedFiles="true"
          Condition="Exists('$(_LibOut)$(_NativeName)')" />
  </Target>

</Project>
