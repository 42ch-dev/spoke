 }
 
+/// Top-level function name, prefixed with `New` when it would collide with an object type.
+pub fn free_fn_name(func: &Function, ci: &ComponentInterface) -> Result<String, askama::Error> {
+    let base = oracle().fn_name(func.name());
+    if let Some(return_type) = func.return_type() {
+        if let Type::Object { name, .. } = return_type {
+            if oracle().class_name(name) == base {
+                return Ok(format!("New{}", base));
+            }
+        }
+    }
+    Ok(base)
+}
+
