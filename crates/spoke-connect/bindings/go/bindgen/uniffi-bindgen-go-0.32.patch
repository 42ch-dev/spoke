+pub struct SetCodeType<'a> {
+    inner: Type,
+    ci: &'a ComponentInterface,
+}
+
+impl<'a> SetCodeType<'a> {
+    pub fn new(inner: Type, ci: &'a ComponentInterface) -> Self {
+        Self { inner, ci }
+    }
+
+    fn inner(&self) -> &Type {
+        &self.inner
+    }
