{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "noEmit": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@42ch/spoke-schemas": [
        "../../../packages/spoke-schemas/src/index.ts"
      ],
      "@42ch/spoke-operations": [
        "../../../packages/spoke-operations/src/index.ts"
      ],
      "@42ch/spoke-connect/remote": [
        "../../../packages/spoke-connect-ts/src/remote/index.ts"
      ],
      "@42ch/spoke-connect": [
        "../../../packages/spoke-connect-ts/src/index.ts"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "tests/**/*.ts",
    "vitest.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
