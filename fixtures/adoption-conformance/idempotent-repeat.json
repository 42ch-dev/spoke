              "body": {},
              "extensions": {}
            }
          },
          {
            "entry_id": "ke_shared_b",
            "entry": {
              "schema_version": 1,
              "entry_id": "ke_shared_b",
              "entry_type": "note",
              "canonical_name": "shared-b",
              "status": "confirmed",
              "revision": 5,
              "body": {},
              "extensions": {}
            }
          }
        ]
      },
      "setup": [
        {
          "op": "knowledge.adopt",
          "request": {
            "source_scope_id": "spc_shared",
