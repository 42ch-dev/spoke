{
  "id": "idempotent-repeat",
  "title": "Repeat and idempotency — recorded-outcome replay, anchor repeat rules, digest conflict, evicted receipt",
  "protocol_refs": [
    "§Repeat and idempotency",
    "§Refusal vocabulary"
  ],
  "cases": [
    {
      "id": "same-key-replay-returns-recorded-outcome",
      "invariant": "§Repeat and idempotency",
      "surface": "wire",
      "outcome": "identical",
      "what": "a same-key same-request replay returns outcome already_present — the recorded copy — without re-executing the port call",
      "input": {
        "sources": [
          {
            "entry_id": "ke_shared_a",
            "entry": {
              "schema_version": 1,
              "entry_id": "ke_shared_a",
              "entry_type": "note",
              "canonical_name": "shared-a",
              "status": "confirmed",
              "revision": 5,
              "body": {},
              "extensions": {}
            }
          }
        ]
      },
      "op": "knowledge.adopt",
      "request": {
        "source_scope_id": "spc_shared",
        "source_entry_id": "ke_shared_a",
        "source_revision": 5,
        "destination_scope_id": "spc_local",
        "idempotency_key": "replay-key-1",
        "extensions": {}
      },
      "expect": {
        "success": true,
        "state": [{ "path": "outcome", "equals": "adopted" }],
        "provider_calls": 1
      },
      "then": [
        {
          "op": "knowledge.adopt",
          "request": {
            "source_scope_id": "spc_shared",
            "source_entry_id": "ke_shared_a",
            "source_revision": 5,
            "destination_scope_id": "spc_local",
            "idempotency_key": "replay-key-1",
            "extensions": {}
          },
          "expect": {
            "success": true,
            "state": [
              { "path": "outcome", "equals": "already_present" },
              { "path": "entry.adoption_anchor.source_entry_id", "equals": "ke_shared_a" }
            ],
            "provider_calls": 1
          }
        }
      ]
    },
    {
