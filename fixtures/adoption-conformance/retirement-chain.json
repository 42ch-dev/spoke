{
  "id": "retirement-chain",
  "title": "Retirement-chain resolution \u2014 terminal live source, cycle, ambiguity, deleted terminal, 32-edge limit",
  "protocol_refs": [
    "\u00a7Retirement-chain resolution",
    "\u00a7Refusal vocabulary"
  ],
  "cases": [
    {
      "id": "merged-source-resolves-to-live-terminal",
      "invariant": "\u00a7Retirement-chain resolution",
      "surface": "wire",
      "outcome": "identical",
      "what": "a merged source resolves through its retirement chain; the anchor records the terminal live source scope/id/revision and the default destination id is the terminal id",
      "input": {
        "sources": [
          {
            "entry_id": "ke_m_old",
            "successors": [
              "ke_m_live"
            ],
            "entry": {
              "schema_version": 1,
              "entry_id": "ke_m_old",
              "entry_type": "note",
              "canonical_name": "ke_m_old",
              "status": "merged",
              "revision": 2,
              "body": {},
              "extensions": {}
            }
          },
          {
            "entry_id": "ke_m_live",
            "entry": {
              "schema_version": 1,
              "entry_id": "ke_m_live",
              "entry_type": "note",
              "canonical_name": "ke_m_live",
              "status": "confirmed",
              "revision": 9,
              "body": {},
              "extensions": {}
            }
          }
        ]
      },
      "op": "knowledge.adopt",
      "request": {
        "source_scope_id": "spc_shared",
        "source_entry_id": "ke_m_old",
        "source_revision": 2,
        "destination_scope_id": "spc_local",
        "idempotency_key": "chain-live-1",
        "extensions": {}
      },
      "expect": {
        "success": true,
        "state": [
          {
            "path": "outcome",
            "equals": "adopted"
          },
          {
            "path": "entry.entry_id",
            "equals": "ke_m_live"
          },
          {
            "path": "entry.adoption_anchor.source_scope_id",
            "equals": "spc_shared"
          },
          {
            "path": "entry.adoption_anchor.source_entry_id",
            "equals": "ke_m_live"
          },
          {
            "path": "entry.adoption_anchor.source_revision",
            "equals": 9
          }
        ],
        "provider_calls": 1
      },
      "then": [
        {
          "op": "port.knowledge.get",
          "request": {
            "entry_id": "ke_m_live"
          },
          "expect": {
            "success": true,
            "state": [
              {
                "path": "adoption_anchor.source_entry_id",
                "equals": "ke_m_live"
              },
              {
                "path": "adoption_anchor.source_revision",
                "equals": 9
              }
            ]
          }
        },
        {
          "op": "knowledge.adopt",
          "request": {
            "source_scope_id": "spc_shared",
            "source_entry_id": "ke_m_old",
            "source_revision": 2,
            "destination_scope_id": "spc_local",
            "idempotency_key": "chain-live-2",
            "extensions": {}
          },
          "expect": {
            "success": true,
            "state": [
              {
                "path": "outcome",
                "equals": "already_present"
              },
              {
                "path": "entry.entry_id",
                "equals": "ke_m_live"
              },
              {
                "path": "entry.adoption_anchor.source_revision",
                "equals": 9
              }
            ],
            "provider_calls": 2
          }
        }
      ]
    },
