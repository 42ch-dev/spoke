{
  "id": "dedup-replay",
  "title": "Prune deduplication — recorded outcome replay, payload-digest conflict, evicted receipt, key required",
  "protocol_refs": [
    "§9.1",
    "§Refusal vocabulary"
  ],
  "cases": [
    {
      "id": "prune-replay-returns-recorded-outcome",
      "invariant": "§9.1",
      "surface": "wire",
      "outcome": "identical",
      "what": "a same-namespace, same-key, same-digest replay returns the recorded prune outcome without re-executing the port call",
      "input": {
        "entities": [
          {
            "entity_kind": "knowledge_entry",
            "entity_id": "ke_dedup",
            "checkpoints": [1, 3, 5],
            "stored_snapshot": {
              "schema_version": 1,
              "entity_kind": "knowledge_entry",
              "entity_id": "ke_dedup",
              "revision": 1,
              "snapshot": {
                "schema_version": 1,
                "entry_id": "ke_dedup",
                "entry_type": "note",
                "canonical_name": "dedup-fixture",
                "status": "confirmed",
                "revision": 1,
                "body": {},
                "extensions": {}
              },
              "extensions": {}
            }
          }
        ]
      },
      "op": "history.revisions.prune",
      "request": {
        "entity_kind": "knowledge_entry",
        "entity_id": "ke_dedup",
        "keep": 2,
        "idempotency_key": "dedup-key-1"
      },
      "expect": {
        "success": true,
        "state": [
          { "path": "deleted", "equals": 1 },
          { "path": "floor_revision", "equals": 2 }
        ],
        "provider_calls": 1
      },
      "then": [
        {
          "op": "history.revisions.prune",
          "request": {
            "entity_kind": "knowledge_entry",
            "entity_id": "ke_dedup",
            "keep": 2,
            "idempotency_key": "dedup-key-1"
          },
          "expect": {
            "success": true,
            "state": [
              { "path": "deleted", "equals": 1 },
              { "path": "floor_revision", "equals": 2 }
            ],
            "provider_calls": 1
          }
        }
      ]
    },
    {
