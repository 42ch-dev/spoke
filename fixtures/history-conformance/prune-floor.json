            "keep": 2,
            "idempotency_key": "prune-before-put"
          }
        },
        {
          "op": "port.knowledge.put",
          "request": {
            "entry": {
              "schema_version": 1,
              "entry_id": "ke_floor",
              "entry_type": "note",
              "canonical_name": "floor-fixture",
              "status": "confirmed",
              "body": {},
              "extensions": {},
              "revision": 5,
