            "stored_snapshot": {
              "schema_version": 1,
              "entity_kind": "knowledge_entry",
              "entity_id": "ke_floor",
              "revision": 1,
              "snapshot": {
                "schema_version": 1,
                "entry_id": "ke_floor",
                "entry_type": "note",
                "canonical_name": "floor-fixture",
                "status": "confirmed",
                "revision": 1,
                "body": {},
                "extensions": {}
              },
              "extensions": {}
            }
          }
        ]
      },
      "setup": [
        {
          "op": "history.revisions.prune",
          "request": {
            "entity_kind": "knowledge_entry",
            "entity_id": "ke_floor",
            "keep": 2,
            "idempotency_key": "prune-setup"
          }
        }
