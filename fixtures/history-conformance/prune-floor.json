          "spoke-history",
          "spoke-knowledge"
        ],
        "seed_entries": [
          {
            "schema_version": 1,
            "entry_id": "ke_floor",
            "entry_type": "note",
            "canonical_name": "floor-fixture",
            "status": "confirmed",
            "body": {},
            "extensions": {},
            "revision": 5,
            "created_at": "2025-01-01T00:00:00Z",
            "updated_at": "2025-01-01T00:00:00Z"
          }
        ],
        "entities": [
          {
            "entity_kind": "knowledge_entry",
            "entity_id": "ke_floor",
