{
  "id": "prune-floor",
  "title": "Explicit pruning, floor_revision and below-floor refusals \u2014 the {1,3,5} + keep=2 worked example",
  "protocol_refs": [
    "\u00a7Checkpoints, pruning, and floor_revision",
    "\u00a7Refusal vocabulary"
  ],
  "cases": [
    {
      "id": "prune-floor-keep-2-worked-example",
      "invariant": "\u00a7Checkpoints, pruning, and floor_revision",
      "surface": "wire",
      "outcome": "identical",
      "what": "checkpoints {1,3,5} pruned with keep=2 delete {1} and answer deleted=1, floor_revision=2",
      "input": {
        "entities": [
          {
            "entity_kind": "knowledge_entry",
            "entity_id": "ke_floor",
            "checkpoints": [
              1,
              3,
              5
            ],
            "stored_snapshot": {
              "schema_version": 1,
              "entity_kind": "knowledge_entry",
              "entity_id": "ke_floor",
              "revision": 1,
              "snapshot": {
                "schema_version": 1,
                "entry_id": "ke_floor",
                "entry_type": "note",
                "canonical_name": "floor-fixture",
                "status": "confirmed",
                "revision": 1,
                "body": {},
                "extensions": {}
              },
              "extensions": {}
            }
          }
        ]
      },
      "op": "history.revisions.prune",
      "request": {
        "entity_kind": "knowledge_entry",
        "entity_id": "ke_floor",
        "keep": 2,
        "idempotency_key": "prune-floor-keep2"
      },
      "expect": {
        "success": true,
        "state": [
          {
            "path": "deleted",
            "equals": 1
          },
          {
            "path": "floor_revision",
            "equals": 2
          }
        ],
        "provider_calls": 1
      }
    },
    {
      "id": "get-below-floor-truncated",
      "invariant": "\u00a7Refusal vocabulary",
      "surface": "wire",
      "outcome": "identical",
      "what": "after the worked-example prune a read of revision 1 is below floor 2 and answers HISTORY_TRUNCATED with details.floor_revision",
      "input": {
        "entities": [
          {
            "entity_kind": "knowledge_entry",
            "entity_id": "ke_floor",
            "checkpoints": [
              1,
              3,
              5
            ],
            "stored_snapshot": {
              "schema_version": 1,
              "entity_kind": "knowledge_entry",
              "entity_id": "ke_floor",
              "revision": 1,
              "snapshot": {
                "schema_version": 1,
                "entry_id": "ke_floor",
                "entry_type": "note",
                "canonical_name": "floor-fixture",
                "status": "confirmed",
                "revision": 1,
                "body": {},
                "extensions": {}
              },
              "extensions": {}
            }
          }
        ]
      },
      "setup": [
        {
          "op": "history.revisions.prune",
          "request": {
            "entity_kind": "knowledge_entry",
            "entity_id": "ke_floor",
            "keep": 2,
            "idempotency_key": "prune-setup"
          }
        }
      ],
      "op": "history.revisions.get",
      "request": {
        "entity_kind": "knowledge_entry",
        "entity_id": "ke_floor",
        "revision": 1
      },
      "expect": {
        "error_code": "HISTORY_TRUNCATED",
        "details": {
          "floor_revision": 2
        }
      }
    },
    {
