{
  "id": "prune-floor",
  "title": "Explicit pruning, floor_revision and below-floor refusals — the {1,3,5} + keep=2 worked example",
  "protocol_refs": [
    "§Checkpoints, pruning, and floor_revision",
    "§Refusal vocabulary"
  ],
  "cases": [
    {
      "id": "prune-floor-keep-2-worked-example",
      "invariant": "§Checkpoints, pruning, and floor_revision",
      "surface": "wire",
      "outcome": "identical",
      "what": "checkpoints {1,3,5} pruned with keep=2 delete {1} and answer deleted=1, floor_revision=2",
      "input": {
        "entities": [
          {
            "entity_kind": "knowledge_entry",
            "entity_id": "ke_floor",
            "checkpoints": [1, 3, 5],
            "stored_snapshot": {
              "schema_version": 1,
              "entity_kind": "knowledge_entry",
              "entity_id": "ke_floor",
              "revision": 1,
              "snapshot": {
                "schema_version": 1,
                "entry_id": "ke_floor",
                "entry_type": "note",
                "canonical_name": "floor-fixture",
                "status": "confirmed",
                "revision": 1,
                "body": {},
                "extensions": {}
              },
              "extensions": {}
            }
          }
        ]
      },
      "op": "history.revisions.prune",
      "request": {
        "entity_kind": "knowledge_entry",
        "entity_id": "ke_floor",
        "keep": 2,
        "idempotency_key": "prune-floor-keep2"
      },
      "expect": {
        "success": true,
        "state": [
          { "path": "deleted", "equals": 1 },
          { "path": "floor_revision", "equals": 2 }
        ],
        "provider_calls": 1
      }
    },
    {
      "id": "get-below-floor-truncated",
      "invariant": "§Refusal vocabulary",
      "surface": "wire",
      "outcome": "identical",
      "what": "after the worked-example prune a read of revision 1 is below floor 2 and answers HISTORY_TRUNCATED with details.floor_revision",
      "input": {
        "entities": [
          {
            "entity_kind": "knowledge_entry",
            "entity_id": "ke_floor",
            "checkpoints": [1, 3, 5],
            "stored_snapshot": {
              "schema_version": 1,
              "entity_kind": "knowledge_entry",
              "entity_id": "ke_floor",
              "revision": 1,
              "snapshot": {
                "schema_version": 1,
                "entry_id": "ke_floor",
                "entry_type": "note",
                "canonical_name": "floor-fixture",
                "status": "confirmed",
                "revision": 1,
                "body": {},
                "extensions": {}
              },
              "extensions": {}
            }
          }
        ]
      },
      "setup": [
        {
          "op": "history.revisions.prune",
          "request": {
            "entity_kind": "knowledge_entry",
            "entity_id": "ke_floor",
            "keep": 2,
            "idempotency_key": "prune-setup"
          }
        }
      ],
      "op": "history.revisions.get",
      "request": {
        "entity_kind": "knowledge_entry",
        "entity_id": "ke_floor",
        "revision": 1
      },
      "expect": {
        "error_code": "HISTORY_TRUNCATED",
        "details": { "floor_revision": 2 }
      }
    },
    {
      "id": "get-at-floor-reconstructable",
      "invariant": "§Checkpoints, pruning, and floor_revision",
      "surface": "wire",
      "outcome": "identical",
      "what": "a read of revision 2 at the floor is answered from retained checkpoint 3, never rejected as truncated",
      "input": {
        "entities": [
          {
            "entity_kind": "knowledge_entry",
            "entity_id": "ke_floor",
            "checkpoints": [1, 3, 5],
            "stored_snapshot": {
              "schema_version": 1,
              "entity_kind": "knowledge_entry",
              "entity_id": "ke_floor",
              "revision": 1,
              "snapshot": {
                "schema_version": 1,
                "entry_id": "ke_floor",
                "entry_type": "note",
                "canonical_name": "floor-fixture",
                "status": "confirmed",
                "revision": 1,
                "body": {},
                "extensions": {}
              },
              "extensions": {}
            }
          }
        ]
      },
      "setup": [
        {
          "op": "history.revisions.prune",
          "request": {
            "entity_kind": "knowledge_entry",
            "entity_id": "ke_floor",
            "keep": 2,
            "idempotency_key": "prune-setup"
          }
        }
      ],
      "op": "history.revisions.get",
      "request": {
        "entity_kind": "knowledge_entry",
        "entity_id": "ke_floor",
        "revision": 2
      },
      "expect": {
        "success": true,
        "state": [
          { "path": "snapshot.revision", "equals": 2 },
          { "path": "snapshot.snapshot.revision", "equals": 2 },
          { "path": "snapshot.entity_id", "equals": "ke_floor" }
        ]
      }
    },
    {
      "id": "prune-noop-keep-exceeds-count",
      "invariant": "§Checkpoints, pruning, and floor_revision",
      "surface": "wire",
      "outcome": "identical",
      "what": "keep greater than the checkpoint count is a no-op returning deleted=0, floor_revision=null",
      "input": {
        "entities": [
          {
            "entity_kind": "knowledge_entry",
            "entity_id": "ke_floor",
            "checkpoints": [1, 3, 5],
            "stored_snapshot": {
              "schema_version": 1,
              "entity_kind": "knowledge_entry",
              "entity_id": "ke_floor",
              "revision": 1,
              "snapshot": {
                "schema_version": 1,
                "entry_id": "ke_floor",
                "entry_type": "note",
                "canonical_name": "floor-fixture",
                "status": "confirmed",
                "revision": 1,
                "body": {},
                "extensions": {}
              },
              "extensions": {}
            }
          }
        ]
      },
      "op": "history.revisions.prune",
      "request": {
        "entity_kind": "knowledge_entry",
        "entity_id": "ke_floor",
        "keep": 10,
        "idempotency_key": "prune-noop"
      },
      "expect": {
        "success": true,
        "state": [
          { "path": "deleted", "equals": 0 },
          { "path": "floor_revision", "equals": null }
        ]
      }
    },
    {
      "id": "prune-keep-zero-deletes-all",
      "invariant": "§Checkpoints, pruning, and floor_revision",
      "surface": "wire",
      "outcome": "identical",
      "what": "keep=0 deletes every checkpoint (the live row never consumes keep) and floors at newest+1",
      "input": {
        "entities": [
          {
            "entity_kind": "knowledge_entry",
            "entity_id": "ke_floor",
            "checkpoints": [1, 3, 5],
            "stored_snapshot": {
              "schema_version": 1,
              "entity_kind": "knowledge_entry",
              "entity_id": "ke_floor",
              "revision": 1,
              "snapshot": {
                "schema_version": 1,
                "entry_id": "ke_floor",
                "entry_type": "note",
                "canonical_name": "floor-fixture",
                "status": "confirmed",
                "revision": 1,
                "body": {},
                "extensions": {}
              },
              "extensions": {}
            }
          }
        ]
      },
      "op": "history.revisions.prune",
      "request": {
        "entity_kind": "knowledge_entry",
        "entity_id": "ke_floor",
        "keep": 0,
        "idempotency_key": "prune-zero"
      },
      "expect": {
        "success": true,
        "state": [
          { "path": "deleted", "equals": 3 },
          { "path": "floor_revision", "equals": 6 }
        ]
      }
    },
    {
      "id": "prune-then-history-truncated-below-new-floor",
      "invariant": "§Checkpoints, pruning, and floor_revision",
      "surface": "wire",
      "outcome": "identical",
      "what": "after keep=0 the whole retained history is below floor 6; revision 5 answers HISTORY_TRUNCATED with floor_revision 6",
      "input": {
        "entities": [
          {
            "entity_kind": "knowledge_entry",
            "entity_id": "ke_floor",
            "checkpoints": [1, 3, 5],
            "stored_snapshot": {
              "schema_version": 1,
              "entity_kind": "knowledge_entry",
              "entity_id": "ke_floor",
              "revision": 1,
              "snapshot": {
                "schema_version": 1,
                "entry_id": "ke_floor",
                "entry_type": "note",
                "canonical_name": "floor-fixture",
                "status": "confirmed",
                "revision": 1,
                "body": {},
                "extensions": {}
              },
              "extensions": {}
            }
          }
        ]
      },
      "setup": [
        {
          "op": "history.revisions.prune",
          "request": {
            "entity_kind": "knowledge_entry",
            "entity_id": "ke_floor",
            "keep": 0,
            "idempotency_key": "prune-zero-setup"
          }
        }
      ],
      "op": "history.revisions.get",
      "request": {
        "entity_kind": "knowledge_entry",
        "entity_id": "ke_floor",
        "revision": 5
      },
      "expect": {
        "error_code": "HISTORY_TRUNCATED",
        "details": { "floor_revision": 6 }
      }
    }
  ]
}
