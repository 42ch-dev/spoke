    {
      "id": "conditional-put-below-floor-unchanged-occ",
      "invariant": "\u00a7Checkpoints, pruning, and floor_revision",
      "surface": "wire",
      "outcome": "identical",
      "what": "after pruning ke_floor's history to floor 2, a conditional port.knowledge.put with expected_base_revision 1 (below the floor) answers the unchanged OCC refusal STORED_REVISION_STALE against the live revision \u2014 the write path never consults the floor and a put at the live base still commits",
      "input": {
