      "invariant": "\u00a7Checkpoints, pruning, and floor_revision",
      "surface": "wire",
      "outcome": "identical",
      "what": "a read of revision 2 at the floor is answered from retained checkpoint 3, never rejected as truncated",
      "input": {
        "entities": [
          {
            "entity_kind": "knowledge_entry",
            "entity_id": "ke_floor",
            "checkpoints": [
              1,
