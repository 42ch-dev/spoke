{
  "id": "classification",
  "title": "Deterministic candidate classification dispositions (§6.7)",
  "protocol_refs": ["§6.7", "§10"],
  "cases": [
    {
      "id": "promote-core-kind-with-provenance",
      "invariant": "§6.7",
      "surface": "engine",
      "outcome": "variable",
      "what": "a sourced core-kind candidate is promoted with the observed rationale codes",
      "input": {
        "material": {
          "kind": "fact",
          "text": "The gate key is hidden under the third barrel.",
          "has_structured_content": false,
          "occurred_at": "2026-07-23T06:05:00Z",
          "source_context_count": 1,
          "anchor_count": 1
        }
      },
      "expect": {
        "disposition": "promote",
        "rationale_codes": [
          "core_kind",
          "sourced_anchor",
          "provenance_context",
          "occurred_at_known"
        ],
        "confidence": 0.8
      }
    },
    {
      "id": "promote-product-kind-plain",
      "invariant": "§6.7",
      "surface": "engine",
      "outcome": "variable",
      "what": "a product-kind candidate without provenance is still promoted",
      "input": {
        "material": {
          "kind": "belief",
          "text": "Bo is sure the key is kept in the chest.",
          "has_structured_content": false,
          "occurred_at": null,
          "source_context_count": 0,
          "anchor_count": 0
        }
      },
      "expect": {
        "disposition": "promote",
        "rationale_codes": ["product_kind"],
        "confidence": 0.8
      }
    },
    {
      "id": "drop-insufficient-text",
      "invariant": "§6.7",
      "surface": "engine",
      "outcome": "variable",
      "what": "text-only material below the minimum byte length is dropped",
      "input": {
        "material": {
          "kind": "note",
          "text": "short note",
          "has_structured_content": false,
          "occurred_at": null,
          "source_context_count": 0,
          "anchor_count": 0
        }
      },
      "expect": {
        "disposition": "drop",
        "rationale_codes": ["insufficient_text", "core_kind"],
        "confidence": 0.2
      }
    },
    {
      "id": "drop-empty-content",
      "invariant": "§6.7",
      "surface": "engine",
      "outcome": "variable",
      "what": "material with neither text nor structured content is dropped",
      "input": {
        "material": {
          "kind": "fact",
          "text": "",
          "has_structured_content": false,
          "occurred_at": null,
          "source_context_count": 2,
          "anchor_count": 1
        }
      },
      "expect": {
        "disposition": "drop",
        "rationale_codes": ["empty_content"],
        "confidence": 0.0
      }
    },
    {
      "id": "promote-structured-without-text",
      "invariant": "§6.7",
      "surface": "engine",
      "outcome": "variable",
      "what": "structured content alone is enough to promote",
      "input": {
        "material": {
          "kind": "fact",
          "text": "",
          "has_structured_content": true,
          "occurred_at": null,
          "source_context_count": 0,
          "anchor_count": 0
        }
      },
      "expect": {
        "disposition": "promote",
        "rationale_codes": ["core_kind"],
        "confidence": 0.8
      }
    },
    {
      "id": "fragment-oversized-single-claim",
      "invariant": "§6.7",
      "surface": "engine",
      "outcome": "variable",
      "what": "oversized text is fragmented; a single sentence run adds no multiple_claims code",
      "input": {
        "material": {
          "kind": "fact",
          "text": { "$repeat": { "unit": "mira ", "times": 210 } },
          "has_structured_content": false,
          "occurred_at": null,
          "source_context_count": 1,
          "anchor_count": 0
        }
      },
      "expect": {
        "disposition": "fragment",
        "rationale_codes": ["oversized_content", "core_kind"],
        "confidence": 0.6
      }
    },
    {
      "id": "fragment-oversized-multi-claim",
      "invariant": "§6.7",
      "surface": "engine",
      "outcome": "variable",
      "what": "oversized multi-sentence text additionally reports multiple_claims",
      "input": {
        "material": {
          "kind": "event",
          "text": { "$repeat": { "unit": "Mira tallied the barrels. ", "times": 40 } },
          "has_structured_content": false,
          "occurred_at": "2026-07-23T06:00:00Z",
          "source_context_count": 1,
          "anchor_count": 0
        }
      },
      "expect": {
        "disposition": "fragment",
        "rationale_codes": ["oversized_content", "multiple_claims", "core_kind"],
        "confidence": 0.6
      }
    },
    {
      "id": "classification-stable-within-a-provider",
      "invariant": "§6.7",
      "surface": "wire",
      "outcome": "variable",
      "what": "two captures of identical content produce candidates whose advisory dispositions match within the provider (no cross-provider disposition is imposed)",
      "requires": [
        "the provider admits each capture with at least one candidate",
        "the harness resolves `$ref` inside `then` against the response sequence [op-under-test, then[0], then[1], ...]"
      ],
      "op": "memory.capture",
      "request": {
        "space_id": "spc_tw_harbor",
        "subject_id": "toy:character:mira",
        "content": { "text": "Mira told Bo the gate key is hidden under the third barrel." },
        "capture_scope": { "visibility": "context", "context_id": "ctx_tw_customs_gate" },
        "kind_hint": "fact",
        "idempotency_key": "cap-tw-classify-0001"
      },
      "expect": { "receipt_status": "committed" },
      "then": [
        {
          "op": "memory.capture",
          "request": {
            "space_id": "spc_tw_harbor",
            "subject_id": "toy:character:mira",
            "content": { "text": "Mira told Bo the gate key is hidden under the third barrel." },
            "capture_scope": { "visibility": "context", "context_id": "ctx_tw_customs_gate" },
            "kind_hint": "fact",
            "idempotency_key": "cap-tw-classify-0002"
          },
          "expect": { "receipt_status": "committed" }
        },
        {
          "op": "memory.candidates.get",
          "request": {
            "space_id": "spc_tw_harbor",
            "candidate_id": "$ref:0.result.candidate_ids.0"
          },
          "expect": { "success": true }
        },
        {
          "op": "memory.candidates.get",
          "request": {
            "space_id": "spc_tw_harbor",
            "candidate_id": "$ref:1.result.candidate_ids.0"
          },
          "expect": {
            "success": true,
            "unchanged": [
              {
                "path": "candidate.classification.disposition",
                "from_step": 2,
                "from_path": "candidate.classification.disposition"
              }
            ]
          }
        }
      ]
    }
  ]
}
