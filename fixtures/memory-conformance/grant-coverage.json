{
  "id": "grant-coverage",
  "title": "Grant coverage, shared_access, subject_all, and issuance non-amplification",
  "protocol_refs": ["§6.5", "MEM-R006", "MEM-R017", "§7.9"],
  "cases": [
    {
      "id": "covers-context-inside",
      "invariant": "MEM-R006",
      "surface": "engine",
      "outcome": "identical",
      "what": "a context-restricted grant with shared_access covers recall inside its context",
      "input": {
        "kind": "covers",
        "principal_id": "prn_tw_host_primary",
        "space_id": "spc_tw_harbor",
        "now": "2026-07-23T06:30:00Z",
        "grant": {
          "schema_version": 1,
          "grant_id": "grt_tw_mira_context_0001",
          "space_id": "spc_tw_harbor",
          "subject_id": "toy:character:mira",
          "principal_id": "prn_tw_host_primary",
          "capabilities": ["capture", "review", "records_write", "recall"],
          "context_ids": ["ctx_tw_customs_gate"],
          "shared_access": true,
          "created_at": "2026-07-23T05:35:00Z",
          "revision": 1,
          "extensions": {}
        },
        "requirement": {
          "capability": "recall",
          "subject_id": "toy:character:mira",
          "context_ids": ["ctx_tw_customs_gate"],
          "reads_shared": true,
          "subject_all": false
        }
      },
      "expect": { "covers": true }
    },
