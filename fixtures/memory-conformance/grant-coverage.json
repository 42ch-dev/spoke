{
  "id": "grant-coverage",
  "title": "Provider-enforced grant coverage, shared_access, subject_all, and issuance non-amplification",
  "protocol_refs": [
    "\u00a76.5",
    "MEM-R006",
    "MEM-R017",
    "\u00a77.9",
    "\u00a77.22"
  ],
  "cases": [
    {
      "id": "coverage-inside-granted-context",
      "invariant": "MEM-R006",
      "surface": "wire",
      "outcome": "identical",
      "what": "a context-restricted grant with shared_access covers recall inside its context",
      "requires": [
        "prn_tw_host_primary holds grt_tw_mira_context_0001 (ctx_tw_customs_gate, shared_access: true)",
        "toy:character:mira has records in ctx_tw_customs_gate"
      ],
      "op": "memory.recall",
      "request": {
        "space_id": "spc_tw_harbor",
        "subject_id": "toy:character:mira",
        "selection": {
          "mode": "selected_contexts",
          "context_ids": [
            "ctx_tw_customs_gate"
          ],
          "include_shared": true
        },
        "budget": {
          "max_items": 8
        }
      },
      "expect": {
        "success": true
      },
      "principal": "prn_tw_host_primary"
    },
    {
      "id": "coverage-context-outside-grant-denied",
      "invariant": "MEM-R006",
      "surface": "wire",
      "outcome": "identical",
      "what": "the same grant never covers a sibling context it did not name",
      "requires": [
        "prn_tw_host_primary holds grt_tw_mira_context_0001 (ctx_tw_customs_gate only)"
      ],
      "op": "memory.recall",
      "request": {
        "space_id": "spc_tw_harbor",
        "subject_id": "toy:character:mira",
        "selection": {
          "mode": "selected_contexts",
          "context_ids": [
            "ctx_tw_market_square"
          ],
          "include_shared": false
        },
        "budget": {
          "max_items": 8
        }
      },
      "expect": {
        "error_code": "NOT_AUTHORIZED"
      },
      "principal": "prn_tw_host_primary"
    },
    {
      "id": "coverage-shared-without-shared-access-denied",
      "invariant": "MEM-R006",
      "surface": "wire",
      "outcome": "identical",
      "what": "a restricted grant without shared_access cannot read shared visibility",
      "requires": [
        "prn_tw_peer_reader holds a restricted ctx_tw_customs_gate grant with shared_access: false"
      ],
      "op": "memory.recall",
      "request": {
        "space_id": "spc_tw_harbor",
        "subject_id": "toy:character:mira",
        "selection": {
          "mode": "selected_contexts",
          "context_ids": [
            "ctx_tw_customs_gate"
          ],
          "include_shared": true
        },
        "budget": {
          "max_items": 8
        }
      },
      "expect": {
        "error_code": "NOT_AUTHORIZED"
      },
      "principal": "prn_tw_peer_reader"
    },
    {
      "id": "coverage-subject-all-denied-under-restricted-grant",
      "invariant": "MEM-R006",
      "surface": "wire",
      "outcome": "identical",
      "what": "a restricted grant never covers a subject_all selection",
      "requires": [
        "prn_tw_host_primary holds only the restricted grt_tw_mira_context_0001"
      ],
      "op": "memory.recall",
      "request": {
        "space_id": "spc_tw_harbor",
        "subject_id": "toy:character:mira",
        "selection": {
          "mode": "subject_all"
        },
        "budget": {
          "max_items": 8
        }
      },
      "expect": {
        "error_code": "NOT_AUTHORIZED"
      },
      "principal": "prn_tw_host_primary"
    },
    {
      "id": "coverage-subject-all-allowed-for-unrestricted-admin",
      "invariant": "MEM-R006",
      "surface": "wire",
      "outcome": "identical",
      "what": "an unrestricted admin grant covers subject_all including shared visibility",
      "requires": [
        "prn_tw_cli_operator holds the space-wide grt_tw_operator_admin_0002"
      ],
      "op": "memory.recall",
      "request": {
        "space_id": "spc_tw_harbor",
        "subject_id": "toy:character:mira",
        "selection": {
          "mode": "subject_all"
        },
        "budget": {
          "max_items": 32
        }
      },
      "expect": {
        "success": true
      },
      "principal": "prn_tw_cli_operator"
    },
    {
      "id": "coverage-subject-mismatch-denied",
      "invariant": "MEM-R006",
      "surface": "wire",
      "outcome": "identical",
      "what": "a subject-scoped grant never covers another subject",
      "requires": [
        "prn_tw_host_primary holds grt_tw_mira_context_0001 scoped to toy:character:mira"
      ],
      "op": "memory.recall",
      "request": {
        "space_id": "spc_tw_harbor",
        "subject_id": "toy:character:bo",
        "selection": {
          "mode": "selected_contexts",
          "context_ids": [
            "ctx_tw_customs_gate"
          ],
          "include_shared": false
        },
        "budget": {
          "max_items": 8
        }
      },
      "expect": {
        "error_code": "NOT_AUTHORIZED"
      },
      "principal": "prn_tw_host_primary"
    },
    {
      "id": "coverage-expired-grant-denied",
      "invariant": "MEM-R006",
      "surface": "wire",
      "outcome": "identical",
      "what": "an expired grant is treated as revoked, so coverage is absent",
      "requires": [
        "prn_tw_expired_reader holds only an expired mira grant (expires_at in the past)"
      ],
      "op": "memory.recall",
      "request": {
        "space_id": "spc_tw_harbor",
        "subject_id": "toy:character:mira",
        "selection": {
          "mode": "selected_contexts",
          "context_ids": [
            "ctx_tw_customs_gate"
          ],
          "include_shared": false
        },
        "budget": {
          "max_items": 8
        }
      },
      "expect": {
        "error_code": "NOT_AUTHORIZED"
      },
      "principal": "prn_tw_expired_reader"
    },
    {
      "id": "issuance-within-admin-coverage",
      "invariant": "MEM-R017",
      "surface": "wire",
      "outcome": "identical",
      "what": "a space-wide admin grant may issue the restricted mira grant",
      "requires": [
        "prn_tw_cli_operator holds the space-wide grt_tw_operator_admin_0002"
      ],
      "op": "memory.grants.grant",
      "request": {
        "space_id": "spc_tw_harbor",
        "subject_id": "toy:character:mira",
        "principal_id": "prn_tw_host_primary",
        "capabilities": [
          "capture",
          "review",
          "records_write",
          "recall"
        ],
        "context_ids": [
          "ctx_tw_customs_gate"
        ],
        "shared_access": true,
        "idempotency_key": "grant-tw-conformance-0001"
      },
      "expect": {
        "receipt_status": "committed"
      },
      "principal": "prn_tw_host_primary"
    },
    {
      "id": "issuance-context-amplification-denied",
      "invariant": "MEM-R017",
      "surface": "wire",
      "outcome": "identical",
      "what": "an admin grant restricted to one context cannot issue coverage of another",
      "requires": [
        "prn_tw_cli_operator holds only grt_tw_operator_admin_context_0003 (ctx_tw_customs_gate)"
      ],
      "op": "memory.grants.grant",
      "request": {
        "space_id": "spc_tw_harbor",
        "subject_id": "toy:character:mira",
        "principal_id": "prn_tw_host_primary",
        "capabilities": [
          "recall"
        ],
        "context_ids": [
          "ctx_tw_market_square"
        ],
        "idempotency_key": "grant-tw-conformance-0002"
      },
      "expect": {
        "error_code": "NOT_AUTHORIZED"
      },
      "principal": "prn_tw_host_primary"
    },
    {
      "id": "issuance-non-admin-granter-denied",
      "invariant": "MEM-R017",
      "surface": "wire",
      "outcome": "identical",
      "what": "a granter without an admin grant cannot issue any grant",
      "requires": [
        "prn_tw_host_primary holds only grt_tw_mira_context_0001 (no admin capability)"
      ],
      "op": "memory.grants.grant",
      "request": {
        "space_id": "spc_tw_harbor",
        "subject_id": "toy:character:mira",
        "principal_id": "prn_tw_peer_reader",
        "capabilities": [
          "recall"
        ],
        "context_ids": [
          "ctx_tw_customs_gate"
        ],
        "idempotency_key": "grant-tw-conformance-0003"
      },
      "expect": {
        "error_code": "NOT_AUTHORIZED"
      },
      "principal": "prn_tw_host_primary"
    },
    {
      "id": "issuance-expiry-beyond-granter-denied",
      "invariant": "MEM-R017",
      "surface": "wire",
      "outcome": "identical",
      "what": "an issued expiry may not outlive the earliest applicable admin expiry",
      "requires": [
        "prn_tw_cli_operator holds grt_tw_operator_admin_0004 expiring 2026-07-24T00:00:00Z"
      ],
      "op": "memory.grants.grant",
      "request": {
        "space_id": "spc_tw_harbor",
        "subject_id": "toy:character:mira",
        "principal_id": "prn_tw_host_primary",
        "capabilities": [
          "recall"
        ],
        "expires_at": "2026-07-30T00:00:00Z",
        "idempotency_key": "grant-tw-conformance-0004"
      },
      "expect": {
        "error_code": "NOT_AUTHORIZED"
      },
      "principal": "prn_tw_host_primary"
    },
    {
      "id": "issuance-space-wide-denied-for-subject-admin",
      "invariant": "MEM-R017",
      "surface": "wire",
      "outcome": "identical",
      "what": "a subject-scoped admin cannot issue a space-wide grant",
      "requires": [
        "prn_tw_cli_operator holds only grt_tw_operator_admin_mira_0005 (subject toy:character:mira)"
      ],
      "op": "memory.grants.grant",
      "request": {
        "space_id": "spc_tw_harbor",
        "principal_id": "prn_tw_peer_reader",
        "capabilities": [
          "recall"
        ],
        "idempotency_key": "grant-tw-conformance-0005"
      },
      "expect": {
        "error_code": "NOT_AUTHORIZED"
      },
      "principal": "prn_tw_host_primary"
    }
  ]
}
