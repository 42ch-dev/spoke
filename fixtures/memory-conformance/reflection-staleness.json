{
  "id": "reflection-staleness",
  "title": "Reflection basis digests and the provider-enforced staleness triggers (profile update, import activation)",
  "protocol_refs": ["MEM-R013", "§6.9", "§7.25", "§7.31", "prototype design-r3 acceptance addendum"],
  "cases": [
    {
      "id": "unchanged-basis-is-not-stale",
      "invariant": "MEM-R013",
      "surface": "engine",
      "outcome": "identical",
      "what": "identical inputs keep the pinned digest valid, independent of source order",
      "input": {
        "pinned": {
          "selection": {
            "mode": "selected_contexts",
            "context_ids": ["ctx_tw_customs_gate"],
            "include_shared": true
          },
          "filter": null,
          "sources": [
            { "record_id": "rec_tw_gate_key_fact", "revision": 1 },
            { "record_id": "rec_tw_bo_promise", "revision": 1 }
          ],
          "profile_revisions": { "personality": 3 }
        },
        "current": {
          "selection": {
            "mode": "selected_contexts",
            "context_ids": ["ctx_tw_customs_gate"],
            "include_shared": true
          },
          "filter": null,
          "sources": [
            { "record_id": "rec_tw_bo_promise", "revision": 1 },
            { "record_id": "rec_tw_gate_key_fact", "revision": 1 }
          ],
          "profile_revisions": { "personality": 3 }
        }
      },
      "expect": { "stale": false }
    },
    {
      "id": "record-revision-bump-stales-reflection",
      "invariant": "MEM-R013",
      "surface": "engine",
      "outcome": "identical",
      "what": "editing a pinned source record changes the state digest",
      "input": {
        "pinned": {
          "selection": { "mode": "subject_all" },
          "filter": null,
          "sources": [{ "record_id": "rec_tw_gate_key_fact", "revision": 1 }],
          "profile_revisions": { "personality": 3 }
        },
        "current": {
          "selection": { "mode": "subject_all" },
          "filter": null,
          "sources": [{ "record_id": "rec_tw_gate_key_fact", "revision": 2 }],
          "profile_revisions": { "personality": 3 }
        }
      },
      "expect": { "stale": true }
    },
    {
      "id": "selection-change-stales-reflection",
      "invariant": "MEM-R013",
      "surface": "engine",
      "outcome": "identical",
      "what": "widening the selection changes the digests and stales the reflection",
      "input": {
        "pinned": {
          "selection": {
            "mode": "selected_contexts",
            "context_ids": ["ctx_tw_customs_gate"],
            "include_shared": false
          },
          "filter": { "source_context_ids": ["ctx_tw_customs_gate"] },
          "sources": [{ "record_id": "rec_tw_gate_key_fact", "revision": 1 }],
          "profile_revisions": { "personality": 3 }
        },
        "current": {
          "selection": {
            "mode": "selected_contexts",
            "context_ids": ["ctx_tw_customs_gate"],
            "include_shared": true
          },
          "filter": { "source_context_ids": ["ctx_tw_customs_gate"] },
          "sources": [{ "record_id": "rec_tw_gate_key_fact", "revision": 1 }],
          "profile_revisions": { "personality": 3 }
        }
      },
      "expect": { "stale": true }
    },
    {
      "id": "profile-update-stales-reflection",
      "invariant": "MEM-R013",
      "surface": "wire",
      "outcome": "identical",
      "what": "a profile revision bump makes the generated reflection read stale",
      "requires": [
        "spoke-memory-reflection negotiated; prn_tw_cli_operator holds reflect covering the selection",
        "toy:character:mira has a personality profile at revision 1 and records in ctx_tw_customs_gate",
        "memory.receipts.get polls until each receipt is terminal before the next step"
      ],
      "setup": [
        {
          "op": "memory.reflections.state",
          "request": {
            "space_id": "spc_tw_harbor",
            "subject_id": "toy:character:mira",
            "selection": {
              "mode": "selected_contexts",
              "context_ids": ["ctx_tw_customs_gate"],
              "include_shared": true
            }
          },
          "expect": { "success": true }
        },
        {
          "op": "memory.reflections.generate",
          "request": {
            "space_id": "spc_tw_harbor",
            "subject_id": "toy:character:mira",
            "selection": {
              "mode": "selected_contexts",
              "context_ids": ["ctx_tw_customs_gate"],
              "include_shared": true
            },
            "expected_state_digest": "$ref:0.state_digest",
            "idempotency_key": "gen-tw-stale-0001"
          },
          "expect": { "receipt_status": "pending" }
        },
        {
          "op": "memory.receipts.get",
          "request": {
            "space_id": "spc_tw_harbor",
            "receipt_id": "$ref:1.receipt_id"
          },
          "expect": { "receipt_status": "committed" }
        },
        {
          "op": "memory.profile.update",
          "request": {
            "space_id": "spc_tw_harbor",
            "subject_id": "toy:character:mira",
            "profile_kind": "personality",
            "expected_revision": 1,
            "document": {
              "format": "markdown",
              "body": "# Mira\n\nGuarded, loyal, keeps promises. Returns before dawn.\n"
            },
            "idempotency_key": "prof-tw-stale-0002"
          },
          "expect": { "receipt_status": "committed" }
        }
      ],
      "op": "memory.reflections.state",
      "request": {
        "space_id": "spc_tw_harbor",
        "subject_id": "toy:character:mira",
        "selection": {
          "mode": "selected_contexts",
          "context_ids": ["ctx_tw_customs_gate"],
          "include_shared": true
        }
      },
      "expect": {
        "success": true,
        "state": [{ "path": "stale", "equals": true }]
      }
    },
    {
      "id": "import-activation-stales-reflection-unconditionally",
      "invariant": "MEM-R025",
      "surface": "wire",
      "outcome": "identical",
      "what": "an imported reflection whose pinned basis would still match reads stale: true after activation, because §7.31 requires unconditional revalidation",
      "requires": [
        "an empty target space spc_tw_import_target exists and its subject ids are absent",
        "prn_tw_cli_operator holds transfer + admin on spc_tw_import_target",
        "the exported bundle pins personality revision 3 and the two ctx_tw_customs_gate records and ships that profile, so a recomputed basis would match",
        "memory.receipts.get polls until each receipt is terminal before the next step"
      ],
      "setup": [
        {
          "op": "memory.subjects.get",
          "request": {
            "space_id": "spc_tw_import_target",
            "subject_id": "toy:character:mira"
          },
          "expect": { "error_code": "NOT_FOUND" }
        },
        {
          "op": "memory.imports.stage",
          "request": {
            "space_id": "spc_tw_import_target",
            "conflict_policy": "fail",
            "adopt_grants": []
          },
          "stage_from": {
            "asset": "assets/tw-minimal-export.json",
            "chunk_limit": 4096
          },
          "expect": { "receipt_status": "committed" }
        },
        {
          "op": "memory.imports.activate",
          "request": {
            "space_id": "spc_tw_import_target",
            "import_id": "$ref:1.result.import_id",
            "idempotency_key": "imp-tw-stale-0003"
          },
          "expect": { "receipt_status": "pending" }
        },
        {
          "op": "memory.receipts.get",
          "request": {
            "space_id": "spc_tw_import_target",
            "receipt_id": "$ref:2.receipt_id"
          },
          "expect": { "receipt_status": "committed" }
        }
      ],
      "op": "memory.reflections.list",
      "request": {
        "space_id": "spc_tw_import_target",
        "subject_id": "toy:character:mira",
        "limit": 10
      },
      "expect": {
        "success": true,
        "sizes": [{ "path": "reflections", "equals": 1 }],
        "state": [{ "path": "reflections.0.stale", "equals": true }]
      }
    }
  ]
}
