{
  "name": "@42ch/spoke-connect-ts",
  "version": "0.6.1",
  "private": true,
  "description": "SPOKE connect client library — pure-TS identity derivation, Ed25519 hello signing, and RFC 8785 JCS canonicalization",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/42ch-dev/spoke.git",
    "directory": "packages/spoke-connect-ts"
  },
  "homepage": "https://github.com/42ch-dev/spoke",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./node": {
      "types": "./src/node/connect-client.ts",
      "import": "./src/node/connect-client.ts",
      "default": "./src/node/connect-client.ts"
    }
  },
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@42ch/spoke-schemas": "workspace:*",
    "@noble/ed25519": "^3.1.0",
    "@noble/hashes": "^2.2.0",
    "canonicalize": "3.0.0",
    "ws": "^8.18.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/ws": "^8.18.1",
    "typescript": "^5.3.0",
    "vitest": "^3.0.0"
  },
  "keywords": [
    "spoke",
    "connect",
    "ed25519",
    "jcs"
  ]
}
