{
  "name": "@42ch/spoke-connect",
  "version": "0.7.1",
  "description": "SPOKE connect client library — pure-TS identity derivation, Ed25519 hello signing, and RFC 8785 JCS canonicalization",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/42ch-dev/spoke.git",
    "directory": "packages/spoke-connect-ts"
  },
  "homepage": "https://github.com/42ch-dev/spoke",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./node": {
      "import": {
        "types": "./dist/node/connect-client.d.ts",
        "default": "./dist/node/connect-client.js"
      },
      "require": {
        "types": "./dist/node/connect-client.d.cts",
        "default": "./dist/node/connect-client.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsup",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@42ch/spoke-schemas": "workspace:*",
    "@noble/ed25519": "^3.1.0",
    "@noble/hashes": "^2.2.0",
    "canonicalize": "3.0.0",
    "ws": "^8.18.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/ws": "^8.18.1",
    "typescript": "^5.3.0",
    "vitest": "^3.0.0",
    "tsup": "^8.0.0"
  },
  "keywords": [
    "spoke",
    "connect",
    "ed25519",
    "jcs"
  ]
}
