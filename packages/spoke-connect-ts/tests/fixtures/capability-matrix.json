{
  "schema_version": 1,
  "description": "Cross-language capability selection matrix. Each case is an op, the table that owns its requirement (core op table or the product port.* map), the negotiated capability set, the expected required capability and the expected dispatch verdict. Both language harnesses consume this same file byte-for-byte, so a table drift on either side (a knowledge op remapped to another flag, an implication between capability families, or a missing denial) fails one of the twins.",
  "cases": [
    {
      "op": "port.knowledge.get",
      "table": "product",
      "negotiated": ["spoke-knowledge"],
      "required": "spoke-knowledge",
      "allowed": true
    },
    {
