{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "noEmit": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@42ch/spoke-schemas": [
        "../spoke-schemas/src/index.ts"
      ],
      "@42ch/spoke-operations": [
        "../spoke-operations/src/index.ts"
      ],
      "@42ch/spoke-fixture-toy-world": [
        "../../fixtures/toy-world/src/adapter/index.ts"
      ],
      "@42ch/spoke-connect": [
        "./src/index.ts"
      ],
      "@42ch/spoke-connect/node": [
        "./src/node/connect-client.ts"
      ],
      "@42ch/spoke-connect/noise": [
        "./src/noise/index.ts"
      ],
      "@42ch/spoke-connect/remote": [
        "./src/remote/index.ts"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "tests/**/*.ts",
    "vitest.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
