{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://spoke42.invalid/schemas/connect/connect-auth-challenge.schema.json",
  "title": "ConnectAuthChallenge",
  "description": "Extensible auth challenge envelope. Core methods: noise-peerid, capability-token.",
  "type": "object",
  "required": ["challenge_id", "method", "challenge", "extensions"],
  "properties": {
    "challenge_id": {
      "type": "string",
      "minLength": 1,
      "description": "Correlation id for the response."
    },
    "method": {
      "type": "string",
      "minLength": 1,
      "description": "Open vocabulary. Core (documented, not enforced): noise-peerid, capability-token. Reserved name: did."
    },
    "challenge": {
      "type": "string",
      "minLength": 1,
      "description": "Opaque challenge material (nonce / method-specific)."
    },
    "extensions": {
      "$ref": "https://spoke42.invalid/schemas/common/common.schema.json#/definitions/ExtensionMap",
      "description": "Product namespace bag."
    }
  },
  "additionalProperties": false
}
