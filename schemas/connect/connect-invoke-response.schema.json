{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://spoke42.invalid/schemas/connect/connect-invoke-response.schema.json",
  "title": "ConnectInvokeResponse",
  "description": "Remote op reply. Use payload (success) OR error — not both.",
  "oneOf": [
    {
      "type": "object",
      "required": ["session_id", "sequence", "request_id", "payload", "signature", "extensions"],
      "properties": {
        "session_id": {
          "type": "string",
          "description": "Echo of request session_id."
        },
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Echo of request sequence."
        },
        "request_id": {
          "type": "string",
          "description": "Echo of request request_id."
        },
        "payload": {
          "$ref": "https://spoke42.invalid/schemas/common/common.schema.json#/definitions/OpaqueJson",
          "description": "Ops response success envelope (or product-defined success body for non-core op)."
        },
        "signature": {
          "type": "string",
          "minLength": 1,
          "description": "base64url (no padding) of the 64-byte Ed25519 signature over the RFC 8785 JCS canonicalized signed object (spoke-connect-invoke-response-jcs-v1)."
        },
        "extensions": {
          "$ref": "https://spoke42.invalid/schemas/common/common.schema.json#/definitions/ExtensionMap",
          "description": "Product namespace bag."
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["session_id", "sequence", "request_id", "error", "signature", "extensions"],
      "properties": {
        "session_id": {
          "type": "string",
          "description": "Echo of request session_id."
        },
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Echo of request sequence."
        },
        "request_id": {
          "type": "string",
          "description": "Echo of request request_id."
        },
        "error": {
          "$ref": "https://spoke42.invalid/schemas/common/error-envelope.schema.json",
          "description": "Failure: shared error envelope."
        },
        "signature": {
          "type": "string",
          "minLength": 1,
          "description": "base64url (no padding) of the 64-byte Ed25519 signature over the RFC 8785 JCS canonicalized signed object (spoke-connect-invoke-response-jcs-v1)."
        },
        "extensions": {
          "$ref": "https://spoke42.invalid/schemas/common/common.schema.json#/definitions/ExtensionMap",
          "description": "Product namespace bag."
        }
      },
      "additionalProperties": false
    }
  ]
}
