{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://spoke42.invalid/schemas/data/knowledge-entry.schema.json",
  "title": "KnowledgeEntry",
  "description": "Atomic narrative knowledge unit: identity, typed body, provenance envelope.",
  "type": "object",
  "required": [
    "schema_version",
    "entry_id",
    "entry_type",
    "canonical_name",
    "status",
    "body",
    "extensions"
  ],
  "properties": {
    "schema_version": {
      "$ref": "https://spoke42.invalid/schemas/common/common.schema.json#/definitions/SchemaVersion"
    },
    "entry_id": {
      "type": "string",
      "description": "Stable KnowledgeEntry id (opaque to protocol)."
    },
    "entry_type": {
      "type": "string",
      "description": "Open string. Core vocabulary (documented, not enforced): character, location, event (ontology label; ≠ TimelineEvent wire object), scene, act, organization, item, conflict, info_point, era, worldbuilding, note, research, ability, rule (ontology label; ≠ L6 Rule wire object). Products MAY emit values outside this list."
    },
    "canonical_name": {
      "type": "string",
      "minLength": 1,
      "description": "Human-stable name."
    },
    "status": {
      "type": "string",
      "description": "Open string. Core vocabulary (documented, not enforced): provisional, confirmed, deprecated, merged, deleted."
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "description": "Closed L2 payload. Optional summary, tags, trait attributes, and l2-computable state/computable maps only.",
      "properties": {
        "summary": { "type": "string" },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "attributes": {
          "type": "array",
          "items": {
            "$ref": "https://spoke42.invalid/schemas/common/common.schema.json#/definitions/BodyAttribute"
          }
        },
        "state": {
          "$ref": "https://spoke42.invalid/schemas/common/common.schema.json#/definitions/ComputableFieldMap"
        },
        "computable": {
          "$ref": "https://spoke42.invalid/schemas/common/common.schema.json#/definitions/ComputableFieldMap"
        }
      }
    },
    "source_anchor": {
      "$ref": "https://spoke42.invalid/schemas/data/source-anchor.schema.json",
      "description": "Optional provenance pointer."
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "description": "Optimistic concurrency revision."
    },
    "created_at": {
      "$ref": "https://spoke42.invalid/schemas/common/common.schema.json#/definitions/Timestamp"
    },
    "updated_at": {
      "$ref": "https://spoke42.invalid/schemas/common/common.schema.json#/definitions/Timestamp"
    },
    "extensions": {
      "$ref": "https://spoke42.invalid/schemas/common/common.schema.json#/definitions/ExtensionMap"
    }
  },
  "additionalProperties": false,
  "examples": [
    {
      "schema_version": 1,
      "entry_id": "kb_01HXYZ",
      "entry_type": "character",
      "canonical_name": "Mira Vale",
      "status": "confirmed",
      "body": {
        "summary": "Protagonist; reluctant cartographer.",
        "tags": ["pov"],
        "attributes": [
          { "trait_type": "role", "value": "protagonist" },
          { "trait_type": "age", "value": 28, "display_type": "number" }
        ]
      },
      "source_anchor": {
        "schema_version": 1,
        "source_id": "manuscript:book-1:ch-3",
        "span": { "start": 120, "end": 480 },
        "extensions": {}
      },
      "revision": 2,
      "created_at": "2026-07-23T08:00:00Z",
      "updated_at": "2026-07-23T09:15:00Z",
      "extensions": {
        "my_product": { "world_id": "wld_abc" }
      }
    },
    {
      "schema_version": 1,
      "entry_id": "kb_01HARBOR",
      "entry_type": "location",
      "canonical_name": "Ashford Harbor",
      "status": "confirmed",
      "body": {
        "summary": "Tide and cargo model for Ashford harbor.",
        "state": { "tide_level": 2.1, "cargo_tons": 40 },
        "computable": { "tide_level": 2.4, "cargo_tons": 38 }
      },
      "extensions": {}
    }
  ]
}
