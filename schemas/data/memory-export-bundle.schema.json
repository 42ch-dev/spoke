{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://spoke42.invalid/schemas/data/memory-export-bundle.schema.json",
  "title": "MemoryExportBundle",
  "description": "Logical transfer artifact for a space or subject export, reassembled from MemoryExportChunks (§6.11, §6.13). Secrets, credentials, and capability tokens MUST NOT appear anywhere in a bundle.",
  "type": "object",
  "required": [
    "schema_version",
    "bundle_format_version",
    "memory_protocol_version",
    "export_id",
    "space_id",
    "created_at",
    "source",
    "subjects",
    "records",
    "candidates",
    "profiles",
    "receipt_summaries",
    "grants",
    "digest",
    "extensions"
  ],
  "properties": {
    "schema_version": {
      "$ref": "https://spoke42.invalid/schemas/common/common.schema.json#/definitions/SchemaVersion"
    },
    "bundle_format_version": {
      "type": "integer",
      "minimum": 1,
      "description": "Starts at 1; independent of memory_protocol_version."
    },
    "memory_protocol_version": {
      "type": "integer",
      "minimum": 1,
      "description": "Protocol version of the exporting provider."
    },
    "export_id": {
      "type": "string",
      "minLength": 1
    },
    "space_id": {
      "type": "string",
      "minLength": 1,
      "description": "Source space."
    },
    "created_at": {
      "$ref": "https://spoke42.invalid/schemas/common/common.schema.json#/definitions/Timestamp"
    },
    "source": {
      "$ref": "#/definitions/Source"
    },
    "subjects": {
      "type": "array",
      "items": {
        "$ref": "https://spoke42.invalid/schemas/data/subject.schema.json"
      },
      "description": "May be empty only if the exported scope has no subjects."
    },
    "records": {
      "type": "array",
      "items": {
        "$ref": "https://spoke42.invalid/schemas/data/retained-record.schema.json"
      },
      "description": "Tombstoned records excluded unless include_tombstoned was requested."
    },
    "candidates": {
      "type": "array",
      "items": {
        "$ref": "https://spoke42.invalid/schemas/data/memory-candidate.schema.json"
      },
      "description": "Content-scrubbed shells (content_digest present) for consumed candidates; full pending candidates. Preserves consumed-operation history (MEM-R025)."
    },
    "profiles": {
      "type": "array",
      "items": {
        "$ref": "https://spoke42.invalid/schemas/data/profile-document.schema.json"
      },
      "description": "May be empty."
    },
    "reflections": {
      "type": "array",
      "items": {
        "$ref": "https://spoke42.invalid/schemas/data/reflection.schema.json"
      },
      "description": "Present iff include_reflections was requested. Excludes tombstone-referencing reflections."
    },
    "receipt_summaries": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/ReceiptSummary"
      },
      "description": "Content-free dedup provenance enabling reimport/replay duplicate suppression without transferring live receipt state."
    },
    "grants": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/GrantSummary"
      },
      "description": "Redacted grant summaries sufficient for explicit administrator adoption via adopt_grants; never auto-activated (MEM-R025)."
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "SHA-256 hex over the JCS canonicalization of the bundle object with the digest field removed."
    },
    "extensions": {
      "$ref": "https://spoke42.invalid/schemas/common/common.schema.json#/definitions/ExtensionMap"
    }
  },
  "additionalProperties": false,
  "definitions": {
    "Source": {
      "type": "object",
      "required": ["authority_host_id", "authority_generation", "engine_policy_version"],
      "properties": {
        "authority_host_id": {
          "type": "string",
          "minLength": 1
        },
        "authority_generation": {
          "type": "integer",
          "minimum": 1
        },
        "engine_policy_version": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "ReceiptSummary": {
      "type": "object",
      "required": [
        "receipt_id",
        "op",
        "requester_principal_ref",
        "payload_digest",
        "status",
        "created_at"
      ],
      "properties": {
        "receipt_id": {
          "type": "string",
          "minLength": 1
        },
        "op": {
          "type": "string",
          "minLength": 1
        },
        "requester_principal_ref": {
          "type": "string",
          "minLength": 1,
          "description": "Opaque correlation label — never credentials or tokens."
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "payload_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "status": {
          "type": "string",
          "enum": ["committed", "pending", "failed"]
        },
        "created_at": {
          "$ref": "https://spoke42.invalid/schemas/common/common.schema.json#/definitions/Timestamp"
        }
      },
      "additionalProperties": false
    },
    "GrantSummary": {
      "type": "object",
      "required": ["grant_id", "principal_ref", "capabilities", "revision"],
      "properties": {
        "grant_id": {
          "type": "string",
          "minLength": 1
        },
        "subject_id": {
          "type": "string",
          "minLength": 1
        },
        "principal_ref": {
          "type": "string",
          "minLength": 1,
          "description": "Opaque correlation label — never credentials or tokens."
        },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "context_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "shared_access": {
          "type": "boolean"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    }
  },
  "examples": [
    {
      "schema_version": 1,
      "bundle_format_version": 1,
      "memory_protocol_version": 1,
      "export_id": "exp_01J8ZR5B2R0EXAMPLE0000301",
