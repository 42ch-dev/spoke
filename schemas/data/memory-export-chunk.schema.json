{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://spoke42.invalid/schemas/data/memory-export-chunk.schema.json",
  "title": "MemoryExportChunk",
  "description": "Bounded wire unit of a MemoryExportBundle (§6.13, MEM-R015). Arrays are concatenated in the fixed field order subjects, records, profiles, reflections, candidates, receipt_summaries, grants and split into consecutive element runs; one element is never split across chunks. Reassembly concatenates the slices in ordinal order and field order; grants slices follow receipt_summaries so §7.31 can reassemble the §6.11 grant summaries.",
  "type": "object",
  "required": [
    "export_id",
    "chunk_ordinal",
    "chunk_count",
    "bundle_digest",
    "chunk_digest",
    "bytes"
  ],
  "properties": {
    "export_id": {
      "type": "string",
      "minLength": 1
    },
    "chunk_ordinal": {
      "type": "integer",
      "minimum": 0,
      "description": "Strict order."
    },
    "chunk_count": {
      "type": "integer",
      "minimum": 1
    },
    "bundle_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "Digest of the logical bundle this chunk belongs to."
    },
    "chunk_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "SHA-256 over the JCS canonicalization of this chunk object minus chunk_digest."
    },
    "header": {
      "type": "object",
      "required": [
        "schema_version",
        "bundle_format_version",
        "memory_protocol_version",
        "export_id",
        "space_id",
        "created_at",
        "source",
        "digest"
      ],
      "properties": {
        "schema_version": {
          "$ref": "https://spoke42.invalid/schemas/common/common.schema.json#/definitions/SchemaVersion"
        },
        "bundle_format_version": {
          "type": "integer",
          "minimum": 1
        },
        "memory_protocol_version": {
          "type": "integer",
          "minimum": 1
        },
        "export_id": {
          "type": "string",
          "minLength": 1
        },
        "space_id": {
          "type": "string",
          "minLength": 1
        },
        "created_at": {
          "$ref": "https://spoke42.invalid/schemas/common/common.schema.json#/definitions/Timestamp"
        },
        "source": {
          "$ref": "https://spoke42.invalid/schemas/data/memory-export-bundle.schema.json#/definitions/Source"
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "extensions": {
          "$ref": "https://spoke42.invalid/schemas/common/common.schema.json#/definitions/ExtensionMap",
          "description": "Optional; may be an empty object. Carries the logical bundle's extensions (decision D8) so reassembly can write it back to MemoryExportBundle.extensions without changing the bundle digest. MUST be omitted from non-header chunks."
        }
      },
      "additionalProperties": false,
      "description": "Present iff chunk_ordinal = 0: all scalar bundle fields."
    },
    "subjects": {
      "type": "array",
      "items": {
        "$ref": "https://spoke42.invalid/schemas/data/subject.schema.json"
      }
    },
    "records": {
      "type": "array",
      "items": {
        "$ref": "https://spoke42.invalid/schemas/data/retained-record.schema.json"
      }
    },
    "profiles": {
      "type": "array",
      "items": {
        "$ref": "https://spoke42.invalid/schemas/data/profile-document.schema.json"
      }
    },
    "reflections": {
      "type": "array",
      "items": {
        "$ref": "https://spoke42.invalid/schemas/data/reflection.schema.json"
      }
    },
    "candidates": {
      "type": "array",
      "items": {
        "$ref": "https://spoke42.invalid/schemas/data/memory-candidate.schema.json"
      }
    },
    "receipt_summaries": {
      "type": "array",
      "items": {
        "$ref": "https://spoke42.invalid/schemas/data/memory-export-bundle.schema.json#/definitions/ReceiptSummary"
      }
    },
    "grants": {
      "type": "array",
      "items": {
        "$ref": "https://spoke42.invalid/schemas/data/memory-export-bundle.schema.json#/definitions/GrantSummary"
      }
    },
    "bytes": {
      "type": "integer",
      "minimum": 1,
      "description": "Serialized chunk size. At most export_chunk_bytes, except a single element larger than the limit, which occupies its own chunk (never split, never dropped)."
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": { "chunk_ordinal": { "const": 0 } },
        "required": ["chunk_ordinal"]
      },
      "then": { "required": ["header"] },
      "else": { "not": { "required": ["header"] } }
    }
  ]
}
