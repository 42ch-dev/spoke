{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://spoke42.invalid/schemas/data/memory-receipt.schema.json",
  "title": "MemoryReceipt",
  "description": "Result of every mutating memory op: content-free outcome summary plus idempotency binding (§6.10, MEM-R008, MEM-R022). Also the sole pending/uncertain-outcome resolution channel (§14.3). Expressed as closed committed/pending/failed variants because draft-07 conditionals (if/then/else) are not derivable by the codegen toolchain; the variant shapes encode the §6.10 lifecycle exactly: result is present iff committed, error is present iff failed, completed_at is present iff status is not pending.",
  "oneOf": [
    {
      "$ref": "https://spoke42.invalid/schemas/data/memory-receipt.schema.json#/definitions/CommittedReceipt"
    },
    {
      "$ref": "https://spoke42.invalid/schemas/data/memory-receipt.schema.json#/definitions/PendingReceipt"
    },
    {
      "$ref": "https://spoke42.invalid/schemas/data/memory-receipt.schema.json#/definitions/FailedReceipt"
    }
  ],
  "definitions": {
    "CommittedReceipt": {
      "type": "object",
      "required": [
        "schema_version",
        "receipt_id",
        "op",
        "space_id",
        "requester_principal_id",
        "payload_digest",
        "status",
        "result",
        "created_at",
        "completed_at",
        "extensions"
      ],
      "properties": {
        "schema_version": {
          "$ref": "https://spoke42.invalid/schemas/common/common.schema.json#/definitions/SchemaVersion"
        },
        "receipt_id": {
          "type": "string",
          "minLength": 1,
          "description": "Provider-assigned.",
          "title": "ReceiptId"
        },
        "op": {
          "type": "string",
          "minLength": 1,
          "description": "The op string that produced this receipt (e.g. memory.capture).",
          "title": "Op"
        },
        "space_id": {
          "type": "string",
          "minLength": 1,
          "title": "SpaceId"
        },
        "requester_principal_id": {
          "type": "string",
          "minLength": 1,
          "description": "Requester identity for receipt-read authorization.",
          "title": "RequesterPrincipalId"
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Echo when supplied — always, except memory.subjects.ensure.",
          "title": "IdempotencyKey"
        },
        "payload_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "SHA-256 over the JCS canonicalization of the request payload object (MEM-R008).",
          "title": "PayloadDigest"
        },
        "status": {
          "const": "committed",
          "type": "string",
          "title": "Status"
        },
        "result": {
          "$ref": "https://spoke42.invalid/schemas/common/common.schema.json#/definitions/OpaqueJson",
          "description": "Content-free op summary: IDs, revisions, counts, outcome enums, digests, cost facts. Never contains record/candidate/profile/reflection bodies. Per-op shapes are narrowed by the emitting op response schema (§7.0.2)."
        },
        "created_at": {
          "$ref": "https://spoke42.invalid/schemas/common/common.schema.json#/definitions/Timestamp"
        },
        "completed_at": {
          "$ref": "https://spoke42.invalid/schemas/common/common.schema.json#/definitions/Timestamp"
        },
        "extensions": {
          "$ref": "https://spoke42.invalid/schemas/common/common.schema.json#/definitions/ExtensionMap"
        }
      },
      "additionalProperties": false,
      "description": "Synchronous commit. error is deliberately absent: present iff failed (§6.10).",
      "title": "CommittedReceipt"
    },
    "PendingReceipt": {
      "type": "object",
