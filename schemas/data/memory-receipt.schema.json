          "description": "Present iff failed; the memory error envelope adds required details.retry_class to the shared error shape (§14.1–14.2)."
        },
        "created_at": {
          "$ref": "https://spoke42.invalid/schemas/common/common.schema.json#/definitions/Timestamp"
        },
        "completed_at": {
          "$ref": "https://spoke42.invalid/schemas/common/common.schema.json#/definitions/Timestamp"
        },
        "extensions": {
          "$ref": "https://spoke42.invalid/schemas/common/common.schema.json#/definitions/ExtensionMap"
        }
      },
      "additionalProperties": false,
      "description": "Failed op; may carry content-free cost facts (§14.3). result is deliberately absent: present iff committed (§6.10).",
      "title": "FailedReceipt"
    },
    "MemoryErrorEnvelope": {
      "title": "MemoryErrorEnvelope",
      "description": "Shared ErrorEnvelope intersected with the memory §14.1–14.2 contract, schema-enforced: details.retry_class is required and the code→retry_class mapping is expressed as closed oneOf branches (§14.2). Terminal codes per §14.2; op_unsupported / capability_missing are the Connect dispatch codes; INTERNAL_ERROR admits retryable (clean no-effect failure) or uncertain. details otherwise stays open for op-specific keys.",
      "oneOf": [
        {
          "allOf": [
            {
              "$ref": "https://spoke42.invalid/schemas/common/error-envelope.schema.json"
            },
            {
              "title": "MemoryErrorPins",
              "required": [
                "details"
              ],
              "properties": {
                "code": {
                  "type": "string",
                  "const": "INVALID_INPUT"
                },
                "details": {
                  "title": "ErrorDetails",
                  "type": "object",
                  "required": [
                    "retry_class"
                  ],
                  "additionalProperties": true,
                  "properties": {
                    "retry_class": {
                      "type": "string",
                      "title": "RetryClass",
                      "const": "terminal"
                    }
                  },
                  "description": "§14.2 requires details.retry_class on every memory error; op-specific keys (limit, errors, reason, scope, missing, last_known_status, idempotency_key) stay open."
                }
              },
              "description": "§14.2: INVALID_INPUT → terminal (fix request/authorization)."
            }
          ]
        },
        {
          "allOf": [
            {
