{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://spoke42.invalid/schemas/data/provenance-filter.schema.json",
  "title": "ProvenanceFilter",
  "description": "Matches records/candidates having at least one provenance source context in the list (§6.13). A filter, never a placement statement; combines with ReadSelection by AND.",
  "type": "object",
  "required": ["source_context_ids"],
  "properties": {
    "source_context_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false,
  "examples": [
    {
      "source_context_ids": ["bnd_mira_harbor_run_7"]
    }
  ]
}
