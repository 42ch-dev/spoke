    "space_id": {
      "type": "string",
      "minLength": 1,
      "title": "SpaceId"
    },
    "candidate_id": {
      "type": "string",
      "minLength": 1,
      "title": "CandidateId"
    },
    "extensions": {
      "$ref": "https://spoke42.invalid/schemas/common/common.schema.json#/definitions/ExtensionMap",
      "description": "Optional transport metadata."
    }
  },
  "additionalProperties": false
}
