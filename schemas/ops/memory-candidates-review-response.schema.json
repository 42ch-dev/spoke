{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://spoke42.invalid/schemas/ops/memory-candidates-review-response.schema.json",
  "title": "MemoryCandidatesReviewResponse",
  "description": "Success returns a MemoryReceipt (§6.10) whose result is a content-free summary: { \"outcome\": \"promoted\" | \"fragmented\" | \"dropped\", \"record_ids\": string[] }. Errors use the shared ErrorEnvelope (§14.1) with details.retry_class (§14.2). Codes documented for memory.candidates.review (§7.15): CANDIDATE_CONSUMED, REVISION_CONFLICT, NOT_FOUND, NOT_AUTHORIZED, INVALID_INPUT, SPACE_FROZEN, SUBJECT_FENCED. Dispatch-layer codes op_unsupported / capability_missing apply at the Connect boundary.",
  "definitions": {
    "CommittedReceipt": {
      "allOf": [
        {
          "$ref": "https://spoke42.invalid/schemas/data/memory-receipt.schema.json"
        },
        {
          "properties": {
            "op": {
              "const": "memory.candidates.review"
            }
          },
          "required": [
            "op"
          ]
        },
        {
          "properties": {
            "status": {
              "const": "committed"
            },
            "result": {
              "type": "object",
              "required": [
                "outcome",
                "record_ids"
              ],
              "properties": {
                "outcome": {
                  "type": "string",
                  "enum": [
                    "promoted",
                    "fragmented",
                    "dropped"
                  ]
                },
                "record_ids": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "additionalProperties": false
            }
          },
          "required": [
            "status",
            "result"
          ]
        }
      ]
    }
  },
  "oneOf": [
    {
      "oneOf": [
        {
          "$ref": "https://spoke42.invalid/schemas/ops/memory-candidates-review-response.schema.json#/definitions/CommittedReceipt"
        },
        {
          "allOf": [
            {
              "$ref": "https://spoke42.invalid/schemas/data/memory-receipt.schema.json"
            },
            {
              "properties": {
                "op": {
                  "const": "memory.candidates.review"
                }
              },
              "required": [
                "op"
              ]
            },
            {
              "properties": {
                "status": {
                  "const": "failed"
                },
                "error": {
                  "$ref": "https://spoke42.invalid/schemas/data/memory-receipt.schema.json#/definitions/MemoryErrorEnvelope",
                  "description": "Memory error envelope: shared ErrorEnvelope plus required details.retry_class (§14.1–14.2)."
                }
              },
              "required": [
                "status",
                "error"
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "object",
      "required": [
        "error"
      ],
      "properties": {
        "error": {
          "$ref": "https://spoke42.invalid/schemas/data/memory-receipt.schema.json#/definitions/MemoryErrorEnvelope",
          "description": "Memory error envelope: shared ErrorEnvelope plus required details.retry_class (§14.1–14.2)."
        },
        "extensions": {
          "$ref": "https://spoke42.invalid/schemas/common/common.schema.json#/definitions/ExtensionMap",
          "description": "Optional transport metadata."
        }
      },
      "additionalProperties": false
    }
  ]
}
