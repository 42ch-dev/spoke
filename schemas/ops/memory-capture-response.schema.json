{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://spoke42.invalid/schemas/ops/memory-capture-response.schema.json",
  "title": "MemoryCaptureResponse",
  "description": "Success returns a MemoryReceipt (§6.10) whose result is a content-free summary: { \"candidate_ids\": string[], \"classified\": int }. Errors use the shared ErrorEnvelope (§14.1) with details.retry_class (§14.2). Codes documented for memory.capture (§7.11): NOT_AUTHORIZED, SPACE_FROZEN, SUBJECT_FENCED, INVALID_INPUT, IDEMPOTENCY_CONFLICT, OUTCOME_UNCERTAIN. Dispatch-layer codes op_unsupported / capability_missing apply at the Connect boundary.",
  "definitions": {
    "CommittedReceipt": {
      "allOf": [
        {
          "$ref": "https://spoke42.invalid/schemas/data/memory-receipt.schema.json"
        },
        {
          "properties": {
            "op": {
              "const": "memory.capture",
              "type": "string",
              "title": "Op"
            }
          },
          "required": [
            "op"
          ],
          "title": "AllOf"
        },
        {
          "properties": {
            "status": {
              "const": "committed",
              "type": "string",
              "title": "Status"
            },
            "result": {
              "type": "object",
              "required": [
                "candidate_ids",
                "classified"
              ],
              "properties": {
                "candidate_ids": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "classified": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "additionalProperties": false,
              "title": "Result"
            }
          },
          "required": [
            "status",
            "result"
          ],
          "title": "AllOf"
        }
      ]
    }
  },
  "oneOf": [
    {
      "oneOf": [
        {
          "$ref": "https://spoke42.invalid/schemas/ops/memory-capture-response.schema.json#/definitions/CommittedReceipt"
        },
        {
          "allOf": [
            {
              "$ref": "https://spoke42.invalid/schemas/data/memory-receipt.schema.json"
            },
            {
              "properties": {
                "op": {
                  "const": "memory.capture",
                  "type": "string",
                  "title": "Op"
                }
              },
              "required": [
                "op"
              ],
              "title": "AllOf"
            },
            {
              "properties": {
                "status": {
                  "const": "failed",
                  "type": "string",
                  "title": "Status"
                }
              },
              "required": [
                "status"
              ],
              "title": "AllOf"
            }
          ]
        }
      ],
      "title": "OneOf"
    },
    {
      "type": "object",
      "required": [
        "error"
      ],
      "properties": {
        "error": {
          "$ref": "https://spoke42.invalid/schemas/data/memory-receipt.schema.json#/definitions/MemoryErrorEnvelope",
          "description": "Memory error envelope: shared ErrorEnvelope plus required details.retry_class (§14.1–14.2)."
        },
        "extensions": {
          "$ref": "https://spoke42.invalid/schemas/common/common.schema.json#/definitions/ExtensionMap",
          "description": "Optional transport metadata."
        }
      },
      "additionalProperties": false,
      "title": "OneOf"
    }
  ],
