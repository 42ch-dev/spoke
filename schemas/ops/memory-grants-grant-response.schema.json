{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://spoke42.invalid/schemas/ops/memory-grants-grant-response.schema.json",
  "title": "MemoryGrantsGrantResponse",
  "description": "Success returns a MemoryReceipt (§6.10) whose result is a content-free summary: { \"grant_id\": string, \"revision\": int }. Errors use the shared ErrorEnvelope (§14.1) with details.retry_class (§14.2). Codes documented for memory.grants.grant (§7.9): NOT_AUTHORIZED, INVALID_INPUT, SPACE_FROZEN, SUBJECT_FENCED. Dispatch-layer codes op_unsupported / capability_missing apply at the Connect boundary.",
  "oneOf": [
    {
      "allOf": [
        {
          "$ref": "https://spoke42.invalid/schemas/data/memory-receipt.schema.json"
        },
        {
          "properties": {
            "op": {
              "const": "memory.grants.grant"
            }
          },
          "required": [
            "op"
          ]
        },
        {
          "properties": {
            "status": {
              "const": "committed"
            },
            "result": {
              "type": "object",
              "required": [
                "grant_id",
                "revision"
              ],
              "properties": {
                "grant_id": {
                  "type": "string",
                  "minLength": 1
                },
                "revision": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "additionalProperties": false
            }
          },
          "required": [
            "status",
            "result"
          ]
        }
      ]
    },
    {
      "type": "object",
      "required": [
        "error"
      ],
      "properties": {
        "error": {
          "$ref": "https://spoke42.invalid/schemas/data/memory-receipt.schema.json#/definitions/MemoryErrorEnvelope",
          "description": "Memory error envelope: shared ErrorEnvelope plus required details.retry_class (§14.1–14.2)."
        },
        "extensions": {
          "$ref": "https://spoke42.invalid/schemas/common/common.schema.json#/definitions/ExtensionMap",
          "description": "Optional transport metadata."
        }
      },
      "additionalProperties": false
    }
  ]
}
