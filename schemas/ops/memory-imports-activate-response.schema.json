{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://spoke42.invalid/schemas/ops/memory-imports-activate-response.schema.json",
  "title": "MemoryImportsActivateResponse",
  "description": "Success returns a MemoryReceipt (§6.10) whose result is a content-free summary: { \"import_id\": string, \"activated\": Counts, \"authority_generation\": int }. Errors use the shared ErrorEnvelope (§14.1) with details.retry_class (§14.2). Codes documented for memory.imports.activate (§7.32): IMPORT_CONFLICT, NOT_FOUND, NOT_AUTHORIZED. Dispatch-layer codes op_unsupported / capability_missing apply at the Connect boundary.",
  "definitions": {
    "CommittedReceipt": {
      "allOf": [
        {
          "$ref": "https://spoke42.invalid/schemas/data/memory-receipt.schema.json"
        },
        {
          "properties": {
            "op": {
              "const": "memory.imports.activate",
              "type": "string",
              "title": "Op"
            }
          },
          "required": [
            "op",
            "idempotency_key"
          ],
          "title": "AllOf",
          "description": "Pins the emitting op, the committed status, the per-op result shape, and the idempotency_key echo (§6.10: keyed mutations echo the supplied key; memory.subjects.ensure is exempt)."
        },
        {
          "properties": {
            "status": {
              "const": "committed",
              "type": "string",
              "title": "Status"
            },
            "result": {
              "type": "object",
              "required": [
                "import_id",
                "activated",
                "authority_generation"
              ],
              "properties": {
                "import_id": {
                  "type": "string",
                  "minLength": 1,
                  "title": "ImportId"
                },
                "activated": {
                  "type": "object",
                  "required": [
                    "subjects",
                    "records",
                    "candidates",
                    "profiles",
                    "reflections",
                    "receipt_summaries"
                  ],
                  "properties": {
                    "subjects": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "records": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "candidates": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "profiles": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "reflections": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "receipt_summaries": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "additionalProperties": false,
                  "title": "Activated"
                },
                "authority_generation": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "additionalProperties": false,
              "title": "Result"
            }
          },
          "required": [
            "status",
            "result"
          ],
          "title": "AllOf"
        }
      ]
    }
  },
  "oneOf": [
    {
      "oneOf": [
        {
          "$ref": "https://spoke42.invalid/schemas/ops/memory-imports-activate-response.schema.json#/definitions/CommittedReceipt"
        },
        {
          "allOf": [
            {
              "$ref": "https://spoke42.invalid/schemas/data/memory-receipt.schema.json"
            },
            {
              "properties": {
                "op": {
                  "const": "memory.imports.activate",
                  "type": "string",
                  "title": "Op"
                }
              },
              "required": [
                "op"
              ],
              "title": "AllOf"
            },
            {
              "properties": {
                "status": {
                  "const": "pending",
                  "type": "string",
                  "title": "Status"
                }
              },
              "required": [
                "status"
              ],
              "title": "AllOf"
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "https://spoke42.invalid/schemas/data/memory-receipt.schema.json"
            },
            {
              "properties": {
                "op": {
                  "const": "memory.imports.activate",
                  "type": "string",
                  "title": "Op"
                }
              },
              "required": [
                "op"
              ],
              "title": "AllOf"
            },
            {
              "properties": {
                "status": {
                  "const": "failed",
                  "type": "string",
                  "title": "Status"
                }
              },
              "required": [
                "status"
              ],
              "title": "AllOf"
            }
          ]
        }
      ],
      "title": "OneOf"
    },
    {
      "type": "object",
      "required": [
        "error"
      ],
      "properties": {
        "error": {
          "$ref": "https://spoke42.invalid/schemas/data/memory-receipt.schema.json#/definitions/MemoryErrorEnvelope",
          "description": "Memory error envelope: shared ErrorEnvelope plus required details.retry_class (§14.1–14.2)."
        },
        "extensions": {
          "$ref": "https://spoke42.invalid/schemas/common/common.schema.json#/definitions/ExtensionMap",
          "description": "Optional transport metadata."
        }
      },
      "additionalProperties": false,
      "title": "OneOf"
    }
  ]
}
