{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://spoke42.invalid/schemas/ops/memory-reflections-generate-response.schema.json",
  "title": "MemoryReflectionsGenerateResponse",
  "description": "Success returns a MemoryReceipt (§6.10) whose result is a content-free summary: { \"reflection_id\": string, \"cost\": { \"units\": number, \"unit_kind\": string }? }. Errors use the shared ErrorEnvelope (§14.1) with details.retry_class (§14.2). Codes documented for memory.reflections.generate (§7.27): PROFILE_INCOMPLETE, INSUFFICIENT_DATA, REVISION_CONFLICT, NOT_AUTHORIZED, SPACE_FROZEN, SUBJECT_FENCED, OUTCOME_UNCERTAIN. Dispatch-layer codes op_unsupported / capability_missing apply at the Connect boundary.",
  "definitions": {
    "CommittedReceipt": {
      "allOf": [
        {
          "$ref": "https://spoke42.invalid/schemas/data/memory-receipt.schema.json"
        },
        {
          "properties": {
            "op": {
              "const": "memory.reflections.generate"
            }
          },
          "required": [
            "op"
          ]
        },
        {
          "properties": {
            "status": {
              "const": "committed"
            },
            "result": {
              "type": "object",
              "required": [
                "reflection_id"
              ],
              "properties": {
                "reflection_id": {
                  "type": "string",
                  "minLength": 1
                },
                "cost": {
                  "type": "object",
                  "required": [
                    "units",
                    "unit_kind"
                  ],
                  "properties": {
                    "units": {
                      "type": "number",
                      "minimum": 0
                    },
                    "unit_kind": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            }
          },
          "required": [
            "status",
            "result"
          ]
        }
      ]
    }
  },
  "oneOf": [
    {
      "oneOf": [
        {
          "$ref": "https://spoke42.invalid/schemas/ops/memory-reflections-generate-response.schema.json#/definitions/CommittedReceipt"
        },
        {
          "allOf": [
            {
              "$ref": "https://spoke42.invalid/schemas/data/memory-receipt.schema.json"
            },
            {
              "properties": {
                "op": {
                  "const": "memory.reflections.generate"
                }
              },
              "required": [
                "op"
              ]
            },
            {
              "properties": {
                "status": {
                  "const": "pending"
                }
              },
              "required": [
                "status"
              ],
              "not": {
                "required": [
                  "result"
                ]
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "https://spoke42.invalid/schemas/data/memory-receipt.schema.json"
            },
            {
              "properties": {
                "op": {
                  "const": "memory.reflections.generate"
                }
              },
              "required": [
                "op"
              ]
            },
            {
              "properties": {
                "status": {
                  "const": "failed"
                },
                "error": {
                  "$ref": "https://spoke42.invalid/schemas/data/memory-receipt.schema.json#/definitions/MemoryErrorEnvelope",
                  "description": "Memory error envelope: shared ErrorEnvelope plus required details.retry_class (§14.1–14.2)."
                }
              },
              "required": [
                "status",
                "error"
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "object",
      "required": [
        "error"
      ],
      "properties": {
        "error": {
          "$ref": "https://spoke42.invalid/schemas/data/memory-receipt.schema.json#/definitions/MemoryErrorEnvelope",
          "description": "Memory error envelope: shared ErrorEnvelope plus required details.retry_class (§14.1–14.2)."
        },
        "extensions": {
          "$ref": "https://spoke42.invalid/schemas/common/common.schema.json#/definitions/ExtensionMap",
          "description": "Optional transport metadata."
        }
      },
      "additionalProperties": false
    }
  ]
}
