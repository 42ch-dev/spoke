{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://spoke42.invalid/schemas/ops/memory-reflections-list-response.schema.json",
  "title": "MemoryReflectionsListResponse",
  "description": "Success payload for memory.reflections.list (§7.26). Errors use the shared ErrorEnvelope (§14.1) with details.retry_class (§14.2). Codes documented for memory.reflections.list (§7.26): No list-specific codes are documented; pagination invalidation uses CURSOR_INVALID (§7.0.7).. Dispatch-layer codes op_unsupported / capability_missing apply at the Connect boundary.",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "reflections"
      ],
      "properties": {
        "reflections": {
          "type": "array",
          "items": {
            "$ref": "https://spoke42.invalid/schemas/data/reflection.schema.json"
          }
        },
        "next_cursor": {
          "type": "string",
          "minLength": 1,
          "description": "Absent = end of results (§7.0.7)."
        },
        "extensions": {
          "$ref": "https://spoke42.invalid/schemas/common/common.schema.json#/definitions/ExtensionMap",
          "description": "Optional transport metadata."
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "error"
      ],
      "properties": {
        "error": {
          "$ref": "https://spoke42.invalid/schemas/data/memory-receipt.schema.json#/definitions/MemoryErrorEnvelope",
          "description": "Memory error envelope: shared ErrorEnvelope plus required details.retry_class (§14.1–14.2)."
        },
        "extensions": {
          "$ref": "https://spoke42.invalid/schemas/common/common.schema.json#/definitions/ExtensionMap",
          "description": "Optional transport metadata."
        }
      },
      "additionalProperties": false
    }
  ]
}
