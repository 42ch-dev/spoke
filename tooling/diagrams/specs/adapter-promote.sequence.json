    {
      "dot": "cyan",
      "title": "Library owns the gates",
      "items": [
        "Terminal-status and revision checks run before any write",
        "Promote acceptance rejects a candidate that cannot be confirmed"
      ]
    },
    {
      "dot": "emerald",
      "title": "Adapter owns the store",
      "items": [
        "expectedBaseRevision null means create; a number must match the stored revision",
        "The adapter returns the assigned revision on the persisted entry"
