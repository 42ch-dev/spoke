      "dot": "cyan",
      "title": "Hello is the trust root",
      "items": [
        "Each side signs its manifest and a fresh nonce",
        "The receiver authorizes on peer_id and signature, then reads host roles"
      ]
    },
    {
      "dot": "emerald",
      "title": "Per-direction ordering",
      "items": [
        "Each peer owns its outbound counter, starting at sequence 0",
        "Responses echo session_id, sequence and request_id"
      ]
    },
